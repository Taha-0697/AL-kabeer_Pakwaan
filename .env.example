# Database Type: 'neon' (PostgreSQL) or 'smss' (SQL Server)
DB_PROVIDER="neon"

# Neon PostgreSQL Connection URL (Primary Org: org-snowy-feather-32339208)
DATABASE_URL="postgresql://neondb_owner:password@ep-example.eastus2.aws.neon.tech/alkabeer_db?sslmode=require"

# SQL Server (SMSS) Connection URL (Alternative option)
# DATABASE_URL="sqlserver://localhost:1433;database=AlKabeerPakwaanDB;user=sa;password=YourPassword;trustServerCertificate=true;"

# JWT Auth Secret Key (Required min 32 chars)
JWT_SECRET="alkabeer_pakwaan_super_secret_jwt_key_2026_production_grade"
JWT_EXPIRES_IN="7d"

# Local File Storage Directory (relative to public/ directory or absolute path)
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5

# Server & App Settings
PORT=3000
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
